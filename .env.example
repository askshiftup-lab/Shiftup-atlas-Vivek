# ==============================================================================
# Atlas Quality Pipeline - Local Environment Configuration Template
# ==============================================================================
# COPY THIS FILE TO .env FOR LOCAL TESTING AGAINST LIVE SERVICES.
# DO NOT COMMIT REAL SECRETS OR PRODUCTION PASSWORDS TO THIS REPO.
#
# If these variables are empty or commented out, the test suite runs in MOCK mode.
# When provided, integration tests will target these running service instances.

# Account & Authentication Service URL (e.g., http://localhost:8001)
ATLAS_AUTH_URL=

# Profile & Interests Service URL (e.g., http://localhost:8002)
ATLAS_PROFILE_URL=
